# Copy this file to .env and fill in your Groq key (free at https://console.groq.com).
# Without a key the app still works: keyword rules understand text, but voice upload is off.
GROQ_API_KEY=

# Optional overrides
# LLM_MODEL=openai/gpt-oss-20b
# STT_MODEL=whisper-large-v3-turbo

# Local (non-Docker) defaults
MONGO_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379/0
BANK_API_URL=http://localhost:8001
